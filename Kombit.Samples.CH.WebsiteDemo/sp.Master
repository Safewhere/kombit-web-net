<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="sp.master.cs" Inherits="Kombit.Samples.CH.WebsiteDemo.sp" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta http-equiv="Pragma" content="no-cache" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Service Provider</title>

    <link rel="stylesheet" href="css/bootstrap.min.css" />
    <link id="siteStyle" runat="server" rel="Stylesheet" href="~/css/Style.css" />
    <link rel="stylesheet" href="<%: AssetUrl("~/EmergencyAssets/portal.css") %>" />
    <script id="demo-scenarios-script" src="<%: AssetUrl("~/EmergencyAssets/scenarios.js") %>" data-root="<%: ResolveUrl("~/") %>"></script>
    

    <script type="text/javascript" src="js/jquery-2.1.4.min.js"></script>
    <script type="text/javascript" src="js/bootstrap.min.js"></script>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

</head>
<body class="kombit-shell">
    <form id="form1" runat="server">
        <header class="portal-header">
            <a class="portal-logo" href="<%: ResolveUrl("~/Default.aspx") %>"><img alt="KOMBIT" src="<%: ResolveUrl("~/images/kombit.png") %>" /></a>
            <strong class="portal-name">KOMBIT Portal</strong><span class="portal-prototype">Prototype</span>
            <a class="portal-settings" href="<%: ResolveUrl("~/Emergency.aspx") %>" aria-label="Login settings"><span class="portal-person" aria-hidden="true"></span><span>Settings</span></a>
        </header>
        <nav class="portal-nav" aria-label="Application"><a href="<%: ResolveUrl("~/MyPage.aspx") %>" <% if (Request.AppRelativeCurrentExecutionFilePath.EndsWith("MyPage.aspx", StringComparison.OrdinalIgnoreCase)) { %>aria-current="page"<% } %>>Home</a><a href="<%: ResolveUrl("~/Emergency.aspx") %>">Login settings</a><a href="<%: ResolveUrl("~/Default.aspx") %>">About this demo</a></nav>
        <div class="portal-main">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>
